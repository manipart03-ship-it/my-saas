{
  "$schema": "design-tokens-v1",
  "meta": {
    "name": "Brass & Ink Design System",
    "description": "Token source of truth for the SaaS product. Every color/spacing/type value used in UI code must trace back to a token here. Never hardcode raw hex/px values in components.",
    "version": "0.1.0"
  },
  "color": {
    "ink": {
      "950": "#14171C",
      "900": "#1C2027",
      "800": "#262B33",
      "700": "#343B45",
      "600": "#4A5361"
    },
    "paper": {
      "50": "#F6F4EF",
      "100": "#EDEBE6"
    },
    "text": {
      "primary": "#EDEBE6",
      "secondary": "#B8BCC4",
      "muted": "#7C818C",
      "onBrand": "#14171C"
    },
    "brand": {
      "500": "#D8A344",
      "600": "#C0902F",
      "700": "#9E7526"
    },
    "success": {
      "500": "#7FA07A",
      "600": "#668762"
    },
    "danger": {
      "500": "#C1594F",
      "600": "#A6473E"
    },
    "border": {
      "subtle": "#2A2F38",
      "default": "#343B45",
      "focus": "#D8A344"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "full": "999px"
  },
  "typography": {
    "fontFamily": {
      "ui": "'IBM Plex Sans', system-ui, sans-serif",
      "mono": "'IBM Plex Mono', ui-monospace, monospace"
    },
    "scale": {
      "xs": "12px",
      "sm": "13px",
      "base": "15px",
      "lg": "18px",
      "xl": "24px",
      "2xl": "32px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "lineHeight": {
      "tight": 1.25,
      "normal": 1.5
    }
  },
  "shadow": {
    "sm": "0 1px 2px rgba(20, 23, 28, 0.4)",
    "md": "0 4px 12px rgba(20, 23, 28, 0.5)",
    "focusRing": "0 0 0 3px rgba(216, 163, 68, 0.35)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "180ms"
    },
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
  }
}
